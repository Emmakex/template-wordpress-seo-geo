{
  "name": "emmakex/template-wordpress-seo-geo",
  "description": "Reusable WordPress foundation for performance, technical SEO, GEO, multilingual delivery and accessibility.",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
    "php-stubs/wordpress-stubs": "7.1.0",
    "phpcsstandards/phpcsextra": "1.5.1",
    "phpcsstandards/phpcsutils": "1.2.3",
    "phpstan/phpstan": "2.2.14",
    "squizlabs/php_codesniffer": "3.13.6",
    "szepeviktor/phpstan-wordpress": "2.0.4",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "quality": [
      "@quality:phpcs",
      "@quality:phpstan"
    ],
    "quality:phpcs": "phpcs --standard=phpcs.xml.dist",
    "quality:phpstan": "phpstan analyse --configuration=phpstan.neon --no-progress"
  }
}
