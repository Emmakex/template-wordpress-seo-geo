{
  "schema_version": 1,
  "preset": "saas-digital-product",
  "product_facing_name": "Tech / SaaS",
  "target_state": "99-percent-finished-before-client-content",
  "current_stage": "home-reference-candidate",
  "design_rule": "final-layout-first-then-content-hydration",
  "legacy_layout_policy": "never-a-design-source",
  "visual_runtime": {
    "shared_design_system": true,
    "required_frontend_javascript": false,
    "remote_fonts": false,
    "remote_visual_dependencies": false,
    "product_visual_policy": "abstract-provisional-until-verified-product-media-exists"
  },
  "pages": {
    "home": {
      "required": true,
      "composition": "saas-home-final-v1",
      "status": "candidate",
      "owns_h1": false,
      "sections": [
        "product-hero",
        "functional-bento",
        "workflow",
        "integrations-trust",
        "use-cases",
        "plans-structure",
        "faq",
        "final-cta"
      ]
    },
    "product": {
      "required": true,
      "status": "next-microphase"
    },
    "features": {
      "required": true,
      "status": "next-microphase"
    },
    "solutions": {
      "required": true,
      "status": "next-microphase"
    },
    "integrations": {
      "required": true,
      "status": "next-microphase"
    },
    "pricing": {
      "required": true,
      "status": "next-microphase",
      "verified_commercial_facts_required": true
    },
    "resources": {
      "required": true,
      "status": "next-microphase"
    },
    "contact-demo": {
      "required": true,
      "status": "next-microphase"
    },
    "single": {
      "required": true,
      "status": "next-microphase"
    },
    "archive": {
      "required": true,
      "status": "next-microphase"
    },
    "404": {
      "required": true,
      "status": "next-microphase"
    }
  },
  "placeholder_policy": {
    "allowed_in_private_candidate": true,
    "blocks_publication_until_resolved": true,
    "allowed_types": [
      "editorial-copy",
      "abstract-product-visual",
      "pricing-structure-without-values",
      "integration-trust-slot"
    ],
    "forbidden_claims": [
      "customer-logos",
      "testimonials",
      "ratings",
      "adoption-metrics",
      "performance-results",
      "certifications",
      "integration-support",
      "pricing-values"
    ]
  },
  "hydration_contract": {
    "preserve_layout": true,
    "preserve_component_hierarchy": true,
    "replace_placeholder_copy": true,
    "replace_product_visual_when_verified": true,
    "replace_commercial_facts_only_from_authoritative_source": true,
    "seo_geo_manager_required_for_initial_visual_completion": false
  },
  "acceptance": {
    "clean_install_looks_finished": true,
    "mobile_semantic_order": true,
    "one_page_h1_owned_by_template": true,
    "zero_required_project_js": true,
    "zero_third_party_requests": true,
    "performance_budgets_must_not_be_relaxed": true,
    "evidence_must_not_be_fabricated": true
  }
}
