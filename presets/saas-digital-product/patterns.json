  "patterns": [
    {
      "slug": "seo-geo-theme/saas-product-overview",
      "viewport_width": 1200,
      "locales": {
        "en_US": {
          "title": "SaaS product overview",
          "description": "Explain the product, its workflow and verified value without inventing claims.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What the product does</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Describe the real problem, the product workflow and the outcome users can verify. Keep claims specific and supportable.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Problem</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Name the concrete workflow or operational problem the product addresses.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">How it works</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Explain the real product flow using capabilities that exist today.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Outcome</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Describe a measurable or observable outcome only when it can be substantiated.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        },
        "es_ES": {
          "title": "Resumen de producto SaaS",
          "description": "Explica el producto, su flujo y valor verificado sin inventar afirmaciones.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Qué hace el producto</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Describe el problema real, el flujo del producto y el resultado que el usuario puede verificar. Mantén las afirmaciones concretas y demostrables.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Problema</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Define el flujo o problema operativo concreto que resuelve el producto.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Cómo funciona</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Explica el flujo real usando capacidades que existen actualmente.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Resultado</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Describe un resultado medible u observable solo cuando pueda demostrarse.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        }
      }
    },
    {
      "slug": "seo-geo-theme/saas-use-cases",
      "viewport_width": 1200,
      "locales": {
        "en_US": {
          "title": "SaaS use cases",
          "description": "Structure real use cases around audiences, jobs and constraints.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Use cases</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Organize use cases around real users and jobs-to-be-done. Replace every prompt with product-specific evidence before publication.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">For this team</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Identify the real audience and the job they need to complete.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">When this happens</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Explain the trigger, constraint or workflow that makes the use case relevant.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">What changes</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Describe the supported workflow improvement without inventing adoption or performance numbers.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        },
        "es_ES": {
          "title": "Casos de uso SaaS",
          "description": "Estructura casos de uso reales por audiencias, tareas y restricciones.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Casos de uso</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Organiza los casos de uso alrededor de usuarios y tareas reales. Sustituye cada guía por evidencia específica del producto antes de publicar.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Para este equipo</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Identifica la audiencia real y la tarea que necesita completar.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Cuando ocurre esto</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Explica el detonante, restricción o flujo que hace relevante el caso.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Qué cambia</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Describe la mejora de flujo soportada sin inventar cifras de adopción o rendimiento.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        }
      }
    },
    {
      "slug": "seo-geo-theme/saas-integrations",
      "viewport_width": 1200,
      "locales": {
        "en_US": {
          "title": "SaaS integrations",
          "description": "Present supported integrations without implying unsupported connectivity.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Integrations</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">List only integrations that are real, supported and maintained. State the connection scope and any limitations.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Supported connection</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Name a real integration and explain what data or workflow it connects.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Setup requirements</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">State the permissions, plan or configuration genuinely required.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Operational boundary</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Clarify which system remains authoritative and what the integration does not control.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        },
        "es_ES": {
          "title": "Integraciones SaaS",
          "description": "Presenta integraciones compatibles sin insinuar conexiones no soportadas.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Integraciones</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Incluye únicamente integraciones reales, compatibles y mantenidas. Indica el alcance de la conexión y sus limitaciones.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Conexión compatible</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Nombra una integración real y explica qué datos o flujo conecta.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Requisitos de configuración</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Indica los permisos, plan o configuración realmente necesarios.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Límite operativo</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Aclara qué sistema sigue siendo la autoridad y qué no controla la integración.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        }
      }
    },
    {
      "slug": "seo-geo-theme/saas-pricing-plans",
      "viewport_width": 1200,
      "locales": {
        "en_US": {
          "title": "SaaS pricing plans",
          "description": "Structure pricing only from real public plan facts.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Plans and pricing</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Publish plan names, prices, limits and included capabilities only when they match the current commercial offer.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Plan</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Add the real plan name and intended audience.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Included</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">List only capabilities and limits that are actually included.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Commercial terms</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">State the real billing period, taxes, trial or contact-sales condition where applicable.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        },
        "es_ES": {
          "title": "Planes y precios SaaS",
          "description": "Estructura precios únicamente a partir de datos públicos reales.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Planes y precios</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Publica nombres, precios, límites y capacidades incluidas solo cuando coincidan con la oferta comercial vigente.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Plan</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Añade el nombre real del plan y su audiencia prevista.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Incluye</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Enumera únicamente capacidades y límites realmente incluidos.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Condiciones comerciales</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Indica periodo de facturación, impuestos, prueba o condición de contacto comercial cuando corresponda.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        }
      }
    },
    {
      "slug": "seo-geo-theme/saas-comparison-framework",
      "viewport_width": 1200,
      "locales": {
        "en_US": {
          "title": "SaaS comparison framework",
          "description": "Create useful, evidence-based comparisons without declaring an unsupported winner.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Comparison framework</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Compare products or approaches only when users genuinely evaluate them together. Use current verifiable facts and explain scope.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Criteria</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Define decision criteria that matter to the intended user.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Evidence</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Use current documentation, visible product behavior or other authoritative sources.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Fit and limitations</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Explain where each approach fits and where evidence is incomplete instead of inventing a winner.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        },
        "es_ES": {
          "title": "Marco de comparación SaaS",
          "description": "Crea comparaciones útiles basadas en evidencia sin declarar un ganador sin fundamento.",
          "content": "<!-- wp:group {\"backgroundColor\":\"surface\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"right\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\",\"left\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-surface-background-color has-background\">\n<!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Marco de comparación</h2><!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Compara productos o enfoques solo cuando los usuarios los evalúen realmente entre sí. Usa hechos actuales verificables y explica el alcance.</p><!-- /wp:paragraph -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Criterios</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Define criterios de decisión relevantes para el usuario previsto.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Evidencia</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Usa documentación actual, comportamiento visible del producto u otras fuentes autorizadas.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n<!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Encaje y límites</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Explica dónde encaja cada enfoque y dónde falta evidencia, sin inventar un ganador.</p><!-- /wp:paragraph --></div><!-- /wp:column -->\n</div><!-- /wp:columns -->\n</div><!-- /wp:group -->"
        }
      }
    }
  ]
}
