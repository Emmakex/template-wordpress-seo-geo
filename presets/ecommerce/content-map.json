      "dynamic": [
        {
          "key": "shop",
          "provider": "woocommerce",
          "source": "woocommerce-shop",
          "template_owner": "provider",
          "theme_fallback": "archive",
          "requires_integration": true,
          "content_requirements": [
            "productos publicados reales suministrados por el proveedor de comercio",
            "canonical y paginación propiedad del proveedor",
            "sin afirmaciones de precio o disponibilidad generadas por el theme",
            "facetas y filtros sujetos a una política explícita de indexabilidad"
          ]
        },
        {
          "key": "product-category",
          "provider": "woocommerce",
          "source": "woocommerce-product-category",
          "template_owner": "provider",
          "theme_fallback": "archive",
          "requires_integration": true,
          "content_requirements": [
            "taxonomía de productos real propiedad del proveedor",
            "contexto original y útil de categoría cuando se mantenga",
            "los datos visibles de producto siguen siendo propiedad del proveedor",
            "sin contenido de categoría escaso generado automáticamente"
          ]
        },
        {
          "key": "product",
          "provider": "woocommerce",
          "source": "woocommerce-product",
          "template_owner": "provider",
          "theme_fallback": "single",
          "requires_integration": true,
          "content_requirements": [
            "registro de producto real propiedad del proveedor",
            "precio y disponibilidad visibles procedentes del sistema de comercio",
            "datos estructurados Product, Offer y reviews propiedad del proveedor",
            "routing multilingüe de producto propiedad de la integración"
          ]
        }
      ],
      "optional_editorial": [
        {
          "key": "brand-editorial",
          "source": "wordpress-page",
          "template": "page",
          "create_only_when_useful": true,
          "recommended_patterns": [
            "seo-geo-theme/ecommerce-brand-editorial",
            "seo-geo-theme/ecommerce-category-guide",
            "seo-geo-theme/ecommerce-buying-guide"
          ],
          "content_requirements": [
            "valor editorial original más allá del texto del fabricante",
            "productos o categorías reales enlazados solo cuando estén disponibles",
            "afirmaciones sobre la marca verificadas antes de publicar",
            "sin generación automática de landing pages para cada marca"
          ]
        }
      ]
