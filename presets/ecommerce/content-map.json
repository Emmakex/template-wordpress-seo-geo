        {
          "key": "legal-notice",
          "title": "Legal notice",
          "slug": "legal-notice",
          "role": "legal",
          "template": "page",
          "patterns": []
        }
      ],
      "dynamic": [
        {
          "key": "shop",
          "provider": "woocommerce",
          "source": "woocommerce-shop",
          "template_owner": "provider",
          "theme_fallback": "archive",
          "requires_integration": true,
          "content_requirements": [
            "real published products supplied by the commerce provider",
            "provider-owned canonical and pagination behavior",
            "no theme-generated price or availability claims",
            "facets and filters follow an explicit indexability policy"
          ]
        },
        {
          "key": "product-category",
          "provider": "woocommerce",
          "source": "woocommerce-product-category",
          "template_owner": "provider",
          "theme_fallback": "archive",
          "requires_integration": true,
          "content_requirements": [
            "real provider-owned product taxonomy",
            "useful original category context when maintained",
            "visible product facts remain provider-owned",
            "no automatically generated thin category copy"
          ]
        },
        {
          "key": "product",
          "provider": "woocommerce",
          "source": "woocommerce-product",
          "template_owner": "provider",
          "theme_fallback": "single",
          "requires_integration": true,
          "content_requirements": [
            "real provider-owned product record",
            "visible price and availability from the commerce system",
            "Product/Offer/review structured data remains provider-owned",
            "multilingual product routing remains integration-owned"
          ]
        }
      ],
      "optional_editorial": [
        {
          "key": "brand-editorial",
          "source": "wordpress-page",
          "template": "page",
          "create_only_when_useful": true,
          "recommended_patterns": [
            "seo-geo-theme/ecommerce-brand-editorial",
            "seo-geo-theme/ecommerce-category-guide",
            "seo-geo-theme/ecommerce-buying-guide"
          ],
          "content_requirements": [
            "original editorial value beyond manufacturer copy",
            "real products or categories linked only when available",
            "brand claims verified before publication",
            "no automatic landing-page generation for every brand"
          ]
        }
      ]
    },
