{
  "schema_version": 1,
  "preset": "publisher",
  "product_facing_name": "Editorial / Publisher",
  "target_state": "99-percent-finished-before-client-content",
  "current_stage": "system-surfaces-candidate",
  "design_rule": "final-layout-first-then-content-hydration",
  "legacy_layout_policy": "never-a-design-source",
  "visual_runtime": {
    "required_frontend_javascript": false,
    "remote_fonts": false,
    "remote_visual_dependencies": false,
    "real_media_policy": "replace-provisional-visuals-only-with-authorized-editorial-media"
  },
  "pages": {
    "home": {
      "required": true,
      "composition": "publisher-home-final-v1",
      "status": "candidate",
      "owns_h1": false,
      "sections": [
        "editorial-lead",
        "priority-stories",
        "topic-navigation",
        "editorial-standards",
        "evergreen-resources",
        "author-discovery",
        "newsletter-follow"
      ]
    },
    "articles": {"required": true, "composition": "publisher-inner-final-v1", "status": "candidate", "owns_h1": false},
    "topics": {"required": true, "composition": "publisher-inner-final-v1", "status": "candidate", "owns_h1": false},
    "authors": {"required": true, "composition": "publisher-inner-final-v1", "status": "candidate", "owns_h1": false, "real_public_authors_required": true},
    "about": {"required": true, "composition": "publisher-inner-final-v1", "status": "candidate", "owns_h1": false},
    "editorial-policy": {"required": true, "composition": "publisher-inner-final-v1", "status": "candidate", "owns_h1": false, "real_policy_required": true},
    "contact": {"required": true, "composition": "publisher-inner-final-v1", "status": "candidate", "owns_h1": false, "verified_public_routes_required": true},
    "single": {"required": true, "composition": "publisher-single-final-v1", "status": "candidate", "owns_h1": true, "site_editor_custom_template_wins": true, "real_wordpress_author_date_required": true},
    "archive": {"required": true, "composition": "publisher-archive-final-v1", "status": "candidate", "owns_h1": true, "site_editor_custom_template_wins": true, "real_wordpress_posts_required": true},
    "404": {"required": true, "composition": "publisher-404-final-v1", "status": "candidate", "owns_h1": true, "site_editor_custom_template_wins": true, "localized_copy": true}
  },
  "placeholder_policy": {
    "allowed_in_private_candidate": true,
    "blocks_publication_until_resolved": true,
    "allowed_types": [
      "editorial-copy",
      "topic-labels",
      "story-titles",
      "story-summaries",
      "author-discovery-copy",
      "newsletter-copy",
      "provisional-editorial-visual"
    ],
    "forbidden_claims": [
      "fabricated-author-identity",
      "fabricated-author-credentials",
      "fabricated-citations",
      "fabricated-source-urls",
      "fabricated-publication-dates",
      "fabricated-modification-dates",
      "fabricated-read-counts",
      "fabricated-subscriber-counts",
      "fabricated-awards",
      "fabricated-breaking-news-status"
    ]
  },
  "hydration_contract": {
    "preserve_layout": true,
    "preserve_component_hierarchy": true,
    "replace_placeholder_copy": true,
    "replace_story_slots_from_real_content": true,
    "replace_author_slots_from_public_wordpress_users": true,
    "replace_source_slots_only_from_editor_added_references": true,
    "replace_dates_only_from_wordpress_post_timestamps": true,
    "replace_media_only_from_authorized_source": true,
    "seo_geo_manager_required_for_initial_visual_completion": false
  },
  "acceptance": {
    "clean_install_looks_finished": true,
    "scan_before_read_hierarchy": true,
    "calm_reading_surfaces": true,
    "mobile_semantic_order": true,
    "one_page_h1_owned_by_template": true,
    "zero_required_project_js": true,
    "zero_third_party_requests": true,
    "performance_budgets_must_not_be_relaxed": true,
    "evidence_must_not_be_fabricated": true,
    "real_author_source_required": true,
    "real_reference_source_required": true,
    "real_post_dates_required": true,
    "site_editor_custom_templates_are_authoritative": true,
    "missing_preset_template_falls_back_to_neutral_theme": true,
    "system_templates_use_wordpress_content_authority": true
  }
}
