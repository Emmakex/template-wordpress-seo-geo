{
  "schema_version": 1,
  "id": "local-business",
  "version": "1.0.0",
  "site_type": "local-business",
  "intended_for": [
    "local-service-business",
    "storefront",
    "local-professional",
    "service-area-business",
    "multi-location-business"
  ],
  "required_templates": [
    "page",
    "single",
    "archive",
    "index",
    "404"
  ],
  "recommended_base_patterns": [
    "seo-geo-theme/hero",
    "seo-geo-theme/services-features",
    "seo-geo-theme/trust-proof",
    "seo-geo-theme/faq",
    "seo-geo-theme/cta",
    "seo-geo-theme/contact"
  ],
  "preset_patterns": [
    "seo-geo-theme/local-business-nap",
    "seo-geo-theme/local-business-service-area",
    "seo-geo-theme/local-business-location"
  ],
  "schema": {
    "expected_entities": [
      "LocalBusiness",
      "PostalAddress",
      "GeoCoordinates",
      "OpeningHoursSpecification",
      "WebSite",
      "WebPage",
      "BreadcrumbList"
    ],
    "site_identity": "local_business",
    "requires_confirmation": true,
    "visible_fact_gates_required": true,
    "physical_address_required_for_entity": true,
    "notes": "The preset recommends LocalBusiness identity but never enables it automatically. Native Schema remains server-authoritative and only emits facts visible on the public document."
  },
  "location_model": {
    "supports_single_location": true,
    "supports_multiple_locations": true,
    "index_key": "locations",
    "repeatable_key": "location-detail",
    "unique_location_value_required": true,
    "auto_generate_city_pages": false,
    "doorway_pages_forbidden": true,
    "service_area_pages_require_real_local_value": true,
    "schema_boundary": "The native baseline owns one explicitly configured physical LocalBusiness entity. Multi-location preset pages model distinct locations and visible facts without inventing additional Schema entities."
  },
  "navigation": {
    "primary": [
      "home",
      "services",
      "locations",
      "about",
      "faq",
      "contact"
    ],
    "footer": [
      "privacy-policy",
      "legal-notice",
      "contact"
    ]
  },
  "multilingual": {
    "baseline_locales": [
      "en_US",
      "es_ES"
    ],
    "fallback_locale": "en_US",
    "localized_slugs": true,
    "translation_relationships_required": true
  },
  "seo_acceptance": [
    "one canonical per indexable page",
    "localized canonical and hreflang agree",
    "one H1 owned by the page/template composition",
    "LocalBusiness Schema only after explicit confirmed identity and visible physical facts",
    "location pages require unique location-specific value",
    "service-area pages must not be thin doorway pages",
    "private and draft resources excluded from discovery surfaces"
  ],
  "optional_integrations": [],
  "explicitly_disabled": [
    "automatic city landing page generation",
    "LocalBusiness identity inference",
    "review or rating fabrication",
    "location coordinate guessing",
    "opening-hours inference",
    "WooCommerce assumptions"
  ],
  "seo_geo_runtime": {
    "html_delivery": "semantic-server-rendered",
    "primary_navigation": "crawlable-html-anchors",
    "javascript_policy": "zero-by-default",
    "canonical_authority": "shared-core-or-declared-provider",
    "indexability_authority": "shared-core",
    "hreflang_authority": "shared-core",
    "schema_authority": "shared-core-or-declared-provider",
    "single_h1_required": true,
    "internal_links": "crawlable-html-anchors",
    "structured_data_visible_fact_gate": true,
    "llms_txt": "optional-indexable-content-only",
    "markdown_alternates": "optional-noncanonical",
    "content_provenance": "required-when-applicable",
    "responsive_images": "wordpress-srcset-sizes",
    "below_fold_media": "lazy",
    "lcp_media": "not-lazy-loaded",
    "performance_profile": "core-web-vitals-strict"
  },
  "design_direction": {
    "north_star": "immediate-local-trust-and-action",
    "functional_patterns": [
      "local-value-proposition",
      "call-book-quote-directions",
      "services",
      "service-area",
      "hours-location",
      "real-photos",
      "local-faq",
      "contact-map"
    ],
    "modern_traits": [
      "mobile-first-actions",
      "real-photography",
      "compact-action-surfaces",
      "scan-friendly-service-cards",
      "location-context-chips"
    ],
    "avoid": [
      "hidden-contact-facts",
      "fake-review-stars",
      "thin-doorway-location-pages",
      "performance-heavy-map-first-layouts"
    ]
  }
}
