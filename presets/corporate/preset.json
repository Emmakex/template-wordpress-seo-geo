{
  "schema_version": 1,
  "id": "corporate",
  "version": "1.0.0",
  "site_type": "corporate",
  "intended_for": [
    "company",
    "consultancy",
    "agency",
    "b2b-services",
    "professional-services"
  ],
  "required_templates": [
    "page",
    "single",
    "archive",
    "index",
    "404"
  ],
  "recommended_base_patterns": [
    "seo-geo-theme/hero",
    "seo-geo-theme/services-features",
    "seo-geo-theme/trust-proof",
    "seo-geo-theme/faq",
    "seo-geo-theme/cta",
    "seo-geo-theme/contact",
    "seo-geo-theme/author-profile"
  ],
  "preset_patterns": [
    "seo-geo-theme/corporate-case-study",
    "seo-geo-theme/corporate-stats",
    "seo-geo-theme/corporate-testimonials"
  ],
  "schema": {
    "expected_entities": [
      "Organization",
      "WebSite",
      "WebPage",
      "BreadcrumbList",
      "BlogPosting",
      "Person",
      "ProfilePage"
    ],
    "site_identity": "organization",
    "requires_confirmation": true,
    "notes": "Organization identity is suggested by the preset but is never enabled until authoritative organization details are confirmed."
  },
  "navigation": {
    "primary": [
      "home",
      "services",
      "work",
      "about",
      "insights",
      "contact"
    ],
    "footer": [
      "privacy-policy",
      "legal-notice",
      "contact"
    ]
  },
  "multilingual": {
    "baseline_locales": [
      "en_US",
      "es_ES"
    ],
    "fallback_locale": "en_US",
    "localized_slugs": true,
    "translation_relationships_required": true
  },
  "seo_acceptance": [
    "one canonical per indexable page",
    "localized canonical and hreflang agree",
    "one H1 owned by the page/template composition",
    "Organization Schema only after explicit confirmed identity",
    "BlogPosting/Person provenance only on eligible public content",
    "private and draft resources excluded from discovery surfaces"
  ],
  "optional_integrations": [],
  "explicitly_disabled": [
    "LocalBusiness identity inference",
    "WooCommerce assumptions",
    "publisher-only editorial metadata",
    "automatic testimonial or performance claim generation"
  ]
}
