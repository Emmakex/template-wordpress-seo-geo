{
  "schema_version": 1,
  "id": "corporate",
  "version": "2.0.0",
  "site_type": "corporate",
  "intended_for": [
    "company",
    "consultancy",
    "agency",
    "b2b-services",
    "professional-services"
  ],
  "required_templates": [
    "front-page",
    "page",
    "single",
    "archive",
    "index",
    "404"
  ],
  "recommended_base_patterns": [
    "seo-geo-theme/hero",
    "seo-geo-theme/services-features",
    "seo-geo-theme/trust-proof",
    "seo-geo-theme/faq",
    "seo-geo-theme/cta",
    "seo-geo-theme/contact",
    "seo-geo-theme/author-profile"
  ],
  "preset_patterns": [
    "seo-geo-theme/corporate-home-final",
    "seo-geo-theme/corporate-case-study",
    "seo-geo-theme/corporate-stats",
    "seo-geo-theme/corporate-testimonials",
    "seo-geo-theme/corporate-native-hero",
    "seo-geo-theme/corporate-native-capabilities",
    "seo-geo-theme/corporate-native-proof",
    "seo-geo-theme/corporate-native-process",
    "seo-geo-theme/corporate-native-insights"
  ],
  "final_mockup": {
    "contract": "mockup.json",
    "strategy": "complete-layout-before-client-content",
    "placeholder_copy_allowed_in_sandbox": true,
    "placeholder_media_allowed_in_sandbox": true,
    "placeholders_block_production": true,
    "client_content_hydrates_stable_slots": true,
    "legacy_visual_layout_reuse": false
  },
  "schema": {
    "expected_entities": [
      "Organization",
      "WebSite",
      "WebPage",
      "BreadcrumbList",
      "BlogPosting",
      "Person",
      "ProfilePage"
    ],
    "site_identity": "organization",
    "requires_confirmation": true,
    "notes": "Organization identity is suggested by the preset but is never enabled until authoritative organization details are confirmed."
  },
  "navigation": {
    "primary": [
      "home",
      "services",
      "work",
      "about",
      "insights",
      "contact"
    ],
    "footer": [
      "privacy-policy",
      "legal-notice",
      "contact"
    ]
  },
  "multilingual": {
    "baseline_locales": [
      "en_US",
      "es_ES"
    ],
    "fallback_locale": "en_US",
    "localized_slugs": true,
    "translation_relationships_required": true
  },
  "seo_acceptance": [
    "one canonical per indexable page",
    "localized canonical and hreflang agree",
    "one H1 owned by the page/template composition",
    "Organization Schema only after explicit confirmed identity",
    "BlogPosting/Person provenance only on eligible public content",
    "private and draft resources excluded from discovery surfaces",
    "placeholder content cannot pass production readiness"
  ],
  "optional_integrations": [],
  "explicitly_disabled": [
    "LocalBusiness identity inference",
    "WooCommerce assumptions",
    "publisher-only editorial metadata",
    "automatic testimonial or performance claim generation"
  ],
  "visual": {
    "stylesheet": "assets/css/presets/corporate.css",
    "presentation_layer": "assets/css/presets/corporate-v2.css",
    "body_class": "seo-geo-preset-corporate",
    "design_system": "corporate-final-v1",
    "principles": [
      "complete-site-mockup",
      "modern-product-site",
      "editorial-typography",
      "native-wordpress-components",
      "css-first-zero-js",
      "proof-before-decoration",
      "responsive-container-aware",
      "accessible-interactions",
      "brand-adaptable",
      "layout-first-content-hydration",
      "no-legacy-visual-parity"
    ]
  },
  "seo_geo_runtime": {
    "html_delivery": "semantic-server-rendered",
    "primary_navigation": "crawlable-html-anchors",
    "javascript_policy": "zero-by-default",
    "canonical_authority": "shared-core-or-declared-provider",
    "indexability_authority": "shared-core",
    "hreflang_authority": "shared-core",
    "schema_authority": "shared-core-or-declared-provider",
    "single_h1_required": true,
    "internal_links": "crawlable-html-anchors",
    "structured_data_visible_fact_gate": true,
    "llms_txt": "optional-indexable-content-only",
    "markdown_alternates": "optional-noncanonical",
    "content_provenance": "required-when-applicable",
    "responsive_images": "wordpress-srcset-sizes",
    "below_fold_media": "lazy",
    "lcp_media": "not-lazy-loaded",
    "performance_profile": "core-web-vitals-strict"
  },
  "content_semantics": {
    "answer_first_where_useful": true,
    "entity_clarity_required": true,
    "evidence_for_claims_required": true,
    "crawlable_internal_links_required": true,
    "faq_only_when_user_intent": true,
    "author_provenance_when_applicable": true,
    "keyword_stuffing_forbidden": true,
    "doorway_content_forbidden": true,
    "fabricated_proof_forbidden": true
  },
  "design_direction": {
    "north_star": "premium-authority-clarity-proof",
    "functional_patterns": [
      "value-proposition",
      "trust-proof",
      "services",
      "case-studies",
      "method",
      "expertise",
      "insights",
      "contact-cta"
    ],
    "modern_traits": [
      "editorial-typography",
      "disciplined-asymmetry",
      "bounded-whitespace",
      "selective-oversized-statements",
      "large-purposeful-media",
      "alternating-composition-rhythm",
      "restrained-brand-accent",
      "outcome-led-proof"
    ],
    "avoid": [
      "generic-icon-soup",
      "unexplained-counters",
      "decorative-carousels",
      "autoplay-video-backgrounds",
      "placeholder-as-production-content",
      "legacy-visual-parity"
    ]
  },
  "replatforming": {
    "strategy": "preserve-content-seo-links-rebuild-presentation",
    "legacy_visual_parity": false,
    "native_composition_required": true,
    "source_content_may_be_restructured": true,
    "source_media_may_fill_new_visual_slots": true,
    "source_facts_must_not_be_fabricated": true
  }
}
