<?xml version="1.0"?>
<ruleset name="SEO GEO WordPress">
  <description>Project-owned PHP must follow the official WordPress Coding Standards.</description>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg name="parallel" value="8"/>
  <arg value="ps"/>

  <file>packages/seo-geo-theme</file>
  <file>packages/seo-geo-core</file>
  <file>packages/seo-geo-migration-bridge</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <!-- Corporate master CSS is intentionally compact to stay under the strict transfer budget. -->
  <exclude-pattern>packages/seo-geo-theme/assets/css/presets/corporate-v2.css</exclude-pattern>
  <exclude-pattern>packages/seo-geo-theme/assets/css/presets/corporate-v3-runtime.css</exclude-pattern>

  <config name="minimum_supported_wp_version" value="7.1"/>

  <rule ref="WordPress">
    <!--
      The Core intentionally uses a small namespaced autoloader and PSR-style
      class paths. The two filename sniffs below enforce classic WordPress
      lowercase/class-*.php filenames, which are incompatible with that
      deliberate autoload contract. Only filename convention is excluded;
      all naming, documentation, security and interoperability rules remain on.
    -->
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
  </rule>
</ruleset>
