<?xml version="1.0"?>
<ruleset name="SEO GEO WordPress">
  <description>Project-owned PHP must follow the official WordPress Coding Standards.</description>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg name="parallel" value="8"/>
  <arg value="ps"/>

  <file>packages/seo-geo-theme</file>
  <file>packages/seo-geo-core</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>

  <config name="minimum_supported_wp_version" value="7.1"/>

  <rule ref="WordPress">
    <!--
      The Core intentionally uses a small namespaced autoloader and PSR-style
      class paths. WordPress.Files.FileName.InvalidClassFileName assumes the
      classic class-*.php convention, so that filename-only sniff is excluded.
      All other WordPress rules remain active.
    -->
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>
</ruleset>
